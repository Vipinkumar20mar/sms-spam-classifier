    {
      "cell_type": "code",
      "source": [
        "mu.fit(X_train,y_train)#  for multinomialnb  show high accuracy\n",
        "y_pred2=mu.predict(X_test)\n",
        "print(accuracy_score(y_test,y_pred2))\n",
        "print(confusion_matrix(y_test,y_pred2))\n",
